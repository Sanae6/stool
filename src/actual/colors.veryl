pub package color_types {
  struct status_t {
    selected  : logic,
    filled    : logic,
    same_value: logic,
    adjacent  : logic,
  }
}
module colors (
  number_value: input  logic                <4> ,
  is_empty    : input  logic                    ,
  cell_state  : input  color_types::status_t    ,
  color_output: output logic                <24>,
) {
  let baseline: logic<16, 24> = {
    24'hF4EBD7,
    24'hDFD6C4,
    24'hCAC2B1,
