embed (inline) sv{{{
`timescale 1 ns / 1 ns
}}}

import types::*;

module actual_top (
  clk: input clock          ,
  rst: input reset_async_low,

  vsync: input logic    ,
  hsync: input logic    ,
  hpos : input logic<14>,
  vpos : input logic<14>,

  pixel: output logic<24>,
) {
  var puzzle_output: types::bytes_t;
  inst gentop: generator_top (
    clk            ,
    rst            ,
    puzzle_output  ,
  );
  let colors       : logic<10, 24> = {
    24'hFFFFFF,
    24'hFF0000,
    24'hFFAA00,
    24'hAAFF00,
    24'h00FF00,
    24'h00FFAA,
    24'h00AAFF,
    24'h0000FF,
    24'hAA00FF,
    24'hFF00AA
  };

  always_ff {
    let x: logic<5> = ((hpos - 2) / 16) % 9;
    pixel = colors[1 + x];
  }
}
