embed (inline) sv{{{
`timescale 1 ns / 1 ps
}}}

pub package rc5 {
  struct packet_t {
    start  : logic<2>,
    toggle : logic   ,
    address: logic<5>,
    command: logic<6>,
  }
}

pub module remote (
  clk       : input  clock        ,
  rst       : input  reset        ,
  signal    : input  logic        ,
  value     : output rc5::packet_t,
  has_packet: output logic        ,
) {
  enum state_t: logic<2> {
    IDLE,
    SECOND_START_BIT,
    FIFO,
  }

  type pkt_logic = logic<14>;

  inst remdec: remote_manchester (
    clk                      ,
    rst                      ,
    manchester_in: signal    ,
    data_out     : value     ,
    data_valid   : has_packet,
  );

  // var out_bit: logic;
