  // inst remdec: remote_manchester (
  //   clk      ,
  //   rst      ,
  //   signal   ,
  //   out_bit  ,
  //   has_bit  ,
  // );

  // var state: state_t;
  // always_ff {
  //   if_reset {
  //     state = state_t::IDLE;
  //   } else if !has_bit {
  //     state = state;
  //   } else {
  //     state = case state {
  //       state_t::IDLE            : if out_bit ? state_t::SECOND_START_BIT : state_t::IDLE,
  //       state_t::SECOND_START_BIT: if out_bit ? state_t::FIFO : state_t::IDLE,
  //       state_t::FIFO            : if has_packet ? state_t::IDLE : state_t::FIFO,
  //       default                  : state_t::IDLE,
  //     };
  //   }
  // }

  // inst fifo: remote_fifo (
  //   clk                                      ,
  //   rst                                      ,
  //   signal: out_bit                          ,
  //   valid : has_bit && state == state_t::FIFO,
  //   full  : has_packet                       ,
  //   packet: value                            ,
  // );
}

module remote_manchester (
  clk          : input  clock    ,
  rst          : input  reset    ,
  manchester_in: input  logic    ,
  data_out     : output logic<14>,
  data_valid   : output logic    ,
) {
  // Timing parameters for 36 kHz Manchester
  // Bit period = 1/36kHz = 27.78 us
  // Half-bit period = 13.89 us
  // At 126 MHz: cycles per half-bit = 126MHz * 13.89us = 1750 cycles
  const HALF_BIT_COUNT: logic<16> = 1750;
  const SAMPLE_POINT  : logic<16> = HALF_BIT_COUNT / 2;

  // Synchronizer for input signal (prevent metastability)
  var manchester_sync1: logic;
  var manchester_sync2: logic;

  always_ff {
    if_reset {
      manchester_sync1 = 0;
      manchester_sync2 = 0;
    } else {
      manchester_sync1 = manchester_in;
      manchester_sync2 = manchester_sync1;
    }
  }

  // Edge detection
  var manchester_prev: logic;
  let edge_detected  : logic = manchester_sync2 ^ manchester_prev;

  always_ff {
    if_reset {
      manchester_prev = 0;
    } else {
      manchester_prev = manchester_sync2;
    }
  }

  // Timer for sampling
  var timer     : logic<16>;
  var sample_now: logic    ;

  always_ff {
    if_reset {
      timer      = 0;
      sample_now = 0;
    } else {
      sample_now = 0;

      if edge_detected {
        // Reset timer on each edge
        timer    = 0;
        $display("edgeing");
      } else if timer <: HALF_BIT_COUNT {
        timer = timer + 1;

        // Trigger sample at the middle of half-bit
        if timer == SAMPLE_POINT {
          sample_now = 1;
          $display  ("sampling", manchester_sync2);
        }
      } else {
        timer = 0;
      }
    }
  }

  // Manchester decoding state machine
  enum State: logic<2> {
    IDLE = 0,
    FIRST_HALF = 1,
    SECOND_HALF = 2,
  }

  var state           : State    ;
  var first_half_value: logic    ;
  var shift_reg       : logic<14>;
  var bit_count       : logic<4> ;

  always_ff {
    if_reset {
      state            = State::IDLE;
      shift_reg        = 0;
      bit_count        = 0;
      data_out         = 0;
      data_valid       = 0;
      first_half_value = 0;
    } else {
      data_valid       = false;
      shift_reg        = shift_reg;
      bit_count        = bit_count;
      first_half_value = first_half_value;
      state            = state;

      case state {
        State::IDLE: {
          if edge_detected {
            $display        ("edge detected in idle");
            state            = State::SECOND_HALF;
            first_half_value = ~manchester_sync2;
            bit_count        = 0;
          }
        }
        State::FIRST_HALF: {
          if sample_now {
            $display        ("first half %b", manchester_sync2);
            first_half_value = manchester_sync2;
            state            = State::SECOND_HALF;
          }
        }
        State::SECOND_HALF: {
          if sample_now {
            $display("second half %b", first_half_value, manchester_sync2);
            // Manchester decoding:
            // 0->1 transition = logic 1
            // 1->0 transition = logic 0
            if !first_half_value && manchester_sync2 {
              // Rising edge: decoded bit = 1
              shift_reg = {shift_reg[12:0], 1'b1};
              $display ("one bit %b %d", {shift_reg[12:0], 1'b1}, bit_count);
            } else if first_half_value && !manchester_sync2 {
              // Falling edge: decoded bit = 0
              shift_reg = {shift_reg[12:0], 1'b0};
              $display ("zero bit %b %d", {shift_reg[12:0], 1'b0}, bit_count);
            } else {
              // Invalid Manchester - no transition
              state    = State::IDLE;
              $display("invalid manchester bit");
            }

            bit_count = bit_count + 1;

            if bit_count == 13 {
              $display("done!");
              // Full byte received
              data_out   = {shift_reg[12:0], if manchester_sync2 ? 1'b1 : 1'b0};
              data_valid = 1;
              bit_count  = 0;
            }

            state = State::FIRST_HALF;
          }
        }
        default: {
          state = State::IDLE;
        }
      }
    }
  }
}

module remote_fifo (
  clk   : input  clock        ,
  rst   : input  reset        ,
  signal: input  logic        ,
  valid : input  logic        ,
  full  : output logic        ,
  packet: output rc5::packet_t,
) {
  var offset: logic<4> ;
  var bits  : logic<14>;

  assign full = offset == 14;

  always_ff {
    if_reset {
      offset = 0;
      bits   = 0;
      packet = 0 as rc5::packet_t;
    } else if valid {
      if offset == 14 {
        offset = 14;
      } else {
        bits[offset] =  signal;
        offset       += 1;
      }
    } else {
      bits   = bits;
      offset = offset;
    }
  }
}

#[test(remote_top_test)]
embed (inline) sv{{{
  module remote_top;
    var logic clk, rst, signal, has_packet;
    var rc5::packet_t packet;
    remote dut (
      .clk(clk),
      .rst(rst),
      .signal(signal),
      .value(packet),
      .has_packet(has_packet)
    );
    reg [14:0] in_packet = 'b11100001001100;
    integer i;
    initial begin
      $display("starting!");
      signal = 0;
      #20
      $display("starting 2");
      for (i = 0; i < 14; i++) begin
        if (in_packet[13 - i]) begin
          #1749 $display("%d - 1 - low", i);
          signal = 0;
          #1749 $display("%d - 1 - high", i);
          signal = 1;
        end else begin
          #1749 $display("%d - 0 - high", i);
          signal = 1;
          #1749 $display("%d - 0 - low", i);
          signal = 0;
        end
      end

    end

    var logic [4:0] bitcount;
    initial begin
      // $monitor("state", dut.remdec.state);
      // $monitor("shift_reg", dut.remdec.shift_reg);
      // $monitor("state %b %b %b", dut.remdec.state, dut.remdec.manchester_sync1, dut.remdec.manchester_sync2);
      bitcount = 0;
      clk = 1;
      rst = 0;
      @(posedge clk) rst = 1;

      #100000 $error("overrun");
    end

    always begin
      #1
      if (has_packet) begin
        $display("yesss %b %b %b %b", packet.start, packet.toggle, packet.address, packet.command);
        $finish;
      end
    end

    always #0.5 clk = ~clk;
    // always @(posedge clk) begin
    //   if ($time == 889us * 20)
    //     $finish("failed");
    //   if (dut.has_bit) begin
    //     bitcount += 1;
    //     $display("got bit %d %d", bitcount, dut.out_bit);
    //     if (bitcount == 14) $finish;
    //   end
    // end
  endmodule
}}}
